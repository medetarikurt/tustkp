<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Arkadaşın İçin TUS Takip (3 Fazlı)</title>
    <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-app.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-database.js"></script>
    <style>
        :root {
            --bg: #0a0e17; --surface: #131927; --surface-card: #1a2133; --surface-nested: #212a42; --surface-hover: #2a3550; --border: #2d3650;
            --primary: #e8b55f; --primary-variant: #b8863a; --primary-rgb: 232, 181, 95;
            --secondary: #4fd1c5; --text: #e8eaf0; --text-muted: #8b93a7;
            --success: #4ade80; --warning: #fb923c; --danger: #f87171; --info: #60a5fa; color-scheme: dark;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, sans-serif; -webkit-tap-highlight-color: transparent; }
        body { background-color: var(--bg); color: var(--text); display: flex; justify-content: center; padding: 15px; }
        .container { background-color: var(--surface); padding: 20px; border-radius: 14px; width: 100%; max-width: 480px; box-shadow: 0 4px 24px rgba(0,0,0,0.5); }
        h1 { text-align: center; color: var(--primary); margin-bottom: 15px; font-size: 22px; font-weight: 700; }
        .countdown-banner { text-align: center; background: linear-gradient(135deg, var(--primary-variant), var(--primary)); color: #1a1206; padding: 11px; border-radius: 10px; font-weight: 700; font-size: 14px; margin-bottom: 15px; }
        .takvim-nav { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
        .nav-ok { background: transparent; color: var(--text-muted); border: none; font-size: 24px; cursor: pointer; padding: 8px 15px; }
        .yuvarlaklar { display: flex; gap: 12px; align-items: center; }
        .yuvarlak { width: 44px; height: 44px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--surface-nested); font-size: 16px; font-weight: bold; color: var(--text-muted); cursor: pointer;}
        .yuvarlak.aktif { background: var(--primary); color: #1a1206; transform: scale(1.08); }
        .tarih-alt-yazi { text-align: center; color: var(--secondary); font-size: 13px; font-weight: 600; margin-bottom: 20px; text-transform: uppercase; }
        .hedef-karti { background: var(--surface-card); border-left: 4px solid var(--secondary); padding: 16px; border-radius: 10px; margin-bottom: 15px; }
        .hedef-baslik { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; border-bottom: 1px solid var(--border); padding-bottom: 8px; }
        .hedef-baslik h2 { font-size: 18px; color: #fff; }
        .badge { background: var(--primary-variant); color: #1a1206; padding: 4px 9px; border-radius: 5px; font-size: 12px; font-weight: 700; }
        .gorev-item { margin-bottom: 12px; background: var(--surface-nested); padding: 12px; border-radius: 10px; }
        .gorev-item strong { display: block; margin-bottom: 4px; font-size: 14px; text-transform: uppercase; }
        .checkbox-container { display: flex; align-items: center; cursor: pointer; user-select: none; font-size: 14px; color: #ccc; padding: 4px 0; }
        .checkbox-container input { margin-right: 10px; width: 20px; height: 20px; accent-color: var(--success); cursor: pointer; }
        .not-panosu { background: var(--surface-card); border-left: 4px solid var(--info); padding: 14px; border-radius: 10px; margin-bottom: 15px; }
        .not-panosu h2 { font-size: 15px; color: #fff; margin-bottom: 8px; display: flex; justify-content: space-between; }
        .not-status { font-size: 11px; color: var(--success); }
        .not-textarea { width: 100%; height: 80px; background: var(--bg); color: #e0e0e0; border: 1px solid var(--border); border-radius: 8px; padding: 10px; font-size: 14px; resize: vertical; outline: none; font-family: inherit; }
        #toast { position: absolute; top: 10px; left: 50%; transform: translateX(-50%); background: var(--success); color: #06260f; padding: 9px 18px; border-radius: 20px; font-size: 12px; font-weight: bold; opacity: 0; transition: opacity 0.3s; pointer-events: none; }
        select { width: 100%; padding: 10px; border-radius: 8px; border: 1px solid var(--border); background: var(--surface-nested); color: #fff; margin-bottom: 10px; font-size: 16px; outline: none; }
    </style>
</head>
<body>

<div class="container">
    <div id="toast">✅ Kaydedildi</div>
    <h1>TUS Takip & Analiz</h1>
    <div class="countdown-banner" id="countdown-banner">📅 Hesaplanıyor...</div>

    <!-- TAKVİM NAVİGASYONU -->
    <div class="takvim-nav">
        <button class="nav-ok" onclick="tarihDegistir(-1)">❮</button>
        <div class="yuvarlaklar">
            <div class="yuvarlak" id="y-dunku" onclick="tarihDegistir(-1)">-</div>
            <div class="yuvarlak aktif" id="y-bugunku">-</div>
            <div class="yuvarlak" id="y-yarin" onclick="tarihDegistir(1)">-</div>
        </div>
        <button class="nav-ok" onclick="tarihDegistir(1)">❯</button>
    </div>
    <div class="tarih-alt-yazi" id="tarih-metni">Tarih Hesaplanıyor...</div>

    <!-- FAZ SEÇİMİ VE GÖREVLER KARTI -->
    <div id="aktif-ders-karti" class="hedef-karti">
        <div class="hedef-baslik">
            <h2 id="kart-faz-adi">Yükleniyor</h2>
            <span id="kart-tur-gun" class="badge">...</span>
        </div>

        <!-- Ders Seçici (Faz 1 ve Faz 3 için) -->
        <select id="ders-secici" onchange="firebaseKaydet()">
            <option value="Mikrobiyoloji">Mikrobiyoloji</option>
            <option value="Farmakoloji">Farmakoloji</option>
            <option value="Dahiliye">Dahiliye</option>
            <option value="Pediatri">Pediatri</option>
            <option value="Küçük Stajlar">Küçük Stajlar</option>
            <option value="Kadın Doğum">Kadın Doğum (10 Soru)</option>
            <option value="Genel Cerrahi">Genel Cerrahi</option>
        </select>

        <!-- DİNAMİK GÖREVLER ALANI (Fazlara Göre JS ile Doldurulacak) -->
        <div id="dinamik-gorevler"></div>
    </div>

    <!-- DİJİTAL YANLIŞ DEFTERİ (Ocak Ayından İtibaren Kalp Görevi Görecek) -->
    <div class="not-panosu" id="yanlis-panosu">
        <h2>📕 Dijital Yanlış Defteri & Spotlar <span class="not-status" id="yanlis-status"></span></h2>
        <textarea id="yanlis-input" class="not-textarea" placeholder="Yanlış yaptığın soruların kritik spotlarını buraya gir. Ocak-Şubat tekrarlarında hayat kurtaracak..." oninput="yanlisYazildi()" onblur="yanlisKaydet()"></textarea>
    </div>

</div>

<script>
    // YENİ PROJE FIREBASE BİLGİLERİ (Arkadaşın için)
    const firebaseConfig = {
        apiKey: "AIzaSyC6CfL-Tjhb9yPsvbszSvx0IpWbAujrukE",
        authDomain: "elom-a6cc3.firebaseapp.com",
        databaseURL: "https://elom-a6cc3-default-rtdb.firebaseio.com",
        projectId: "elom-a6cc3",
        storageBucket: "elom-a6cc3.firebasestorage.app",
        messagingSenderId: "934231091011",
        appId: "1:934231091011:web:e730d901ec32cb1ba931f6",
        measurementId: "G-0NVK0S0SXN"
    };
    
    if (!firebase.apps.length) { firebase.initializeApp(firebaseConfig); }
    const db = firebase.database();

    let aktifTarih = new Date(new Date().setHours(0,0,0,0));
    const sinavTarihi = new Date(2027, 2, 15); // 15 Mart 2027
    let yanlisTimer;

    function localToISO(dateObj) {
        const offset = dateObj.getTimezoneOffset();
        return new Date(dateObj.getTime() - (offset*60*1000)).toISOString().split('T')[0];
    }

    function gunFarkiBul(d1, d2) {
        const utc1 = Date.UTC(d1.getFullYear(), d1.getMonth(), d1.getDate());
        const utc2 = Date.UTC(d2.getFullYear(), d2.getMonth(), d2.getDate());
        return Math.floor((utc2 - utc1) / (1000 * 60 * 60 * 24));
    }

    window.onload = () => { 
        gunuHesaplaVeArayuzuCiz(); 
        yanlisDefteriGetir();
    };

    function tarihDegistir(gunFarki) {
        aktifTarih.setDate(aktifTarih.getDate() + gunFarki);
        gunuHesaplaVeArayuzuCiz();
    }

    function gunuHesaplaVeArayuzuCiz() {
        const dun = new Date(aktifTarih); dun.setDate(dun.getDate() - 1);
        const yarin = new Date(aktifTarih); yarin.setDate(yarin.getDate() + 1);
        
        document.getElementById("y-dunku").innerText = dun.getDate();
        document.getElementById("y-bugunku").innerText = aktifTarih.getDate();
        document.getElementById("y-yarin").innerText = yarin.getDate();

        const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
        document.getElementById("tarih-metni").innerText = aktifTarih.toLocaleDateString('tr-TR', options);

        updateCountdown();
        fazMotorunuCalistir();
    }

    function updateCountdown() {
        const bugun = new Date(); bugun.setHours(0,0,0,0);
        const kalan = gunFarkiBul(bugun, sinavTarihi);
        const el = document.getElementById("countdown-banner");
        if (kalan > 0) { el.innerText = `📅 TUS'a ${kalan} gün kaldı`; }
        else if (kalan === 0) { el.innerText = `🎯 BUGÜN TUS GÜNÜ! Başarılar!`; }
        else { el.innerText = `✅ TUS geride kaldı`; }
    }

    function fazMotorunuCalistir() {
        const ay = aktifTarih.getMonth(); // 0 = Ocak, 11 = Aralık
        const yil = aktifTarih.getFullYear();
        const gunHafta = aktifTarih.getDay(); // 0 = Pazar
        
        const fazAdi = document.getElementById("kart-faz-adi");
        const fazBadge = document.getElementById("kart-tur-gun");
        const gorevlerAlan = document.getElementById("dinamik-gorevler");
        const dersSecici = document.getElementById("ders-secici");
        
        let gorevHtml = "";

        // FAZ 1: Aralık Sonuna Kadar (2026)
        if (yil <= 2026) {
            fazAdi.innerText = "Faz 1: Temel Atma";
            fazBadge.innerText = "Aralık Sonu Hedefi";
            dersSecici.style.display = "block";
            
            gorevHtml = `
                <div class="gorev-item"><strong style="color: var(--primary);">📖 Konu Çalışması</strong>
                    <label class="checkbox-container"><input type="checkbox" id="chk-konu" onchange="firebaseKaydet()"> Konu bitti</label>
                </div>
                <div class="gorev-item"><strong style="color: var(--secondary);">🎯 Çıkmış Sorular</strong>
                    <label class="checkbox-container"><input type="checkbox" id="chk-cikmis" onchange="firebaseKaydet()"> Çıkmış sorular çözüldü</label>
                </div>
                <div class="gorev-item"><strong style="color: var(--info);">📚 Soru Bankası</strong>
                    <label class="checkbox-container"><input type="checkbox" id="chk-sb" onchange="firebaseKaydet()"> Soru bankası bitti</label>
                </div>
                <div class="gorev-item"><strong style="color: var(--warning);">🔥 24'lü Denemeler</strong>
                    <label class="checkbox-container"><input type="checkbox" id="chk-24deneme" onchange="firebaseKaydet()"> İlgili deneme çözüldü</label>
                </div>
            `;
        } 
        // FAZ 2: Ocak ve Şubat (2027)
        else if (yil === 2027 && (ay === 0 || ay === 1)) {
            fazAdi.innerText = "Faz 2: Tekrar & Yanlışlar";
            fazBadge.innerText = "Ocak - Şubat Modu";
            dersSecici.style.display = "none"; // Tüm dersler olacağı için gizliyoruz
            
            if (gunHafta === 0) { // Pazar Günleri Pretus
                gorevHtml = `
                    <div class="gorev-item" style="border-left: 4px solid var(--warning);">
                        <strong style="color: var(--warning);">📝 Haftalık Pretus</strong>
                        <label class="checkbox-container"><input type="checkbox" id="chk-pretus" onchange="firebaseKaydet()"> Pretus Tam Deneme çözüldü ve analiz edildi</label>
                    </div>
                `;
            } else { // Hafta içi tekrarlar
                gorevHtml = `
                    <div class="gorev-item"><strong style="color: var(--primary);">🔄 Tüm Dersler Tekrarı</strong>
                        <label class="checkbox-container"><input type="checkbox" id="chk-tekrar" onchange="firebaseKaydet()"> Günlük genel tekrar tamamlandı</label>
                    </div>
                    <div class="gorev-item"><strong style="color: var(--danger);">📕 Yanlış Soru Analizi</strong>
                        <label class="checkbox-container"><input type="checkbox" id="chk-yanlis-soru" onchange="firebaseKaydet()"> Havuzdaki yanlış sorular tekrar edildi</label>
                    </div>
                `;
            }
        }
        // FAZ 3: Mart Ayı Son Düzlük (1-14 Mart)
        else if (yil === 2027 && ay === 2) {
            fazAdi.innerText = "Faz 3: Son Düzlük";
            fazBadge.innerText = "Mart Kampı";
            dersSecici.style.display = "block"; // Her güne 1 ders seçilecek
            
            gorevHtml = `
                <div class="gorev-item"><strong style="color: var(--primary);">📖 Günün Dersi Hızlı Tekrar</strong>
                    <label class="checkbox-container"><input type="checkbox" id="chk-mart-ders" onchange="firebaseKaydet()"> Seçili ders tekrarı bitti</label>
                </div>
                <div class="gorev-item"><strong style="color: var(--danger);">📕 Yanlış Sorular</strong>
                    <label class="checkbox-container"><input type="checkbox" id="chk-mart-yanlis" onchange="firebaseKaydet()"> Hızlı yanlış soru taraması yapıldı</label>
                </div>
                <div class="gorev-item" style="border-left: 4px solid var(--warning);"><strong style="color: var(--warning);">🔥 Günlük Genel Deneme</strong>
                    <label class="checkbox-container"><input type="checkbox" id="chk-mart-deneme" onchange="firebaseKaydet()"> Her gün 1 deneme kuralı tamamlandı</label>
                </div>
            `;
        }

        gorevlerAlan.innerHTML = gorevHtml;
        firebaseDurumGetir();
    }

    // FIREBASE KAYIT VE ÇEKME İŞLEMLERİ
    function firebaseDurumGetir() {
        const seciliGunStr = localToISO(aktifTarih);
        db.ref('arkadas_tus_gunluk/' + seciliGunStr).once('value').then((snapshot) => {
            if (snapshot.exists()) {
                const data = snapshot.val();
                if(document.getElementById("ders-secici") && data.seciliDers) document.getElementById("ders-secici").value = data.seciliDers;
                
                // Checkboxları doldur
                const checks = ['chk-konu', 'chk-cikmis', 'chk-sb', 'chk-24deneme', 'chk-pretus', 'chk-tekrar', 'chk-yanlis-soru', 'chk-mart-ders', 'chk-mart-yanlis', 'chk-mart-deneme'];
                checks.forEach(id => {
                    const el = document.getElementById(id);
                    if(el) el.checked = data[id] || false;
                });
            } else {
                // Eğer o güne ait kayıt yoksa checkboxları sıfırla
                const checks = ['chk-konu', 'chk-cikmis', 'chk-sb', 'chk-24deneme', 'chk-pretus', 'chk-tekrar', 'chk-yanlis-soru', 'chk-mart-ders', 'chk-mart-yanlis', 'chk-mart-deneme'];
                checks.forEach(id => {
                    const el = document.getElementById(id);
                    if(el) el.checked = false;
                });
            }
        });
    }

    function firebaseKaydet() {
        const seciliGunStr = localToISO(aktifTarih);
        let kayit = { tarih: seciliGunStr, guncelleme: firebase.database.ServerValue.TIMESTAMP };
        
        if(document.getElementById("ders-secici").style.display !== "none") {
            kayit.seciliDers = document.getElementById("ders-secici").value;
        }

        const checks = ['chk-konu', 'chk-cikmis', 'chk-sb', 'chk-24deneme', 'chk-pretus', 'chk-tekrar', 'chk-yanlis-soru', 'chk-mart-ders', 'chk-mart-yanlis', 'chk-mart-deneme'];
        checks.forEach(id => {
            const el = document.getElementById(id);
            if(el) kayit[id] = el.checked;
        });

        db.ref('arkadas_tus_gunluk/' + seciliGunStr).update(kayit).then(() => toastGoster("✅ Otomatik Kaydedildi"));
    }

    // YANLIŞ DEFTERİ (Eksik Konular panosu devşirmesi)
    function yanlisDefteriGetir() {
        db.ref('arkadas_tus_yanlislar/metin').once('value').then(snap => {
            if(snap.exists()) document.getElementById('yanlis-input').value = snap.val();
        });
    }

    function yanlisYazildi() {
        document.getElementById('yanlis-status').style.color = "var(--text-muted)";
        document.getElementById('yanlis-status').innerText = "Yazılıyor...";
        clearTimeout(yanlisTimer);
        yanlisTimer = setTimeout(yanlisKaydet, 1500);
    }

    function yanlisKaydet() {
        const metin = document.getElementById('yanlis-input').value;
        db.ref('arkadas_tus_yanlislar/metin').set(metin).then(() => {
            document.getElementById('yanlis-status').style.color = "var(--success)";
            document.getElementById('yanlis-status').innerText = "✅ Kaydedildi";
            setTimeout(() => { document.getElementById('yanlis-status').innerText = ""; }, 2500);
        });
    }

    function toastGoster(mesaj) {
        const toast = document.getElementById("toast");
        toast.innerText = mesaj;
        toast.style.opacity = "1";
        setTimeout(() => { toast.style.opacity = "0"; }, 2000);
    }
</script>
</body>
</html>
